{
  "name": "polymarket-agent",
  "version": "1.0.0",
  "description": "Polymarket Escalation Engineering Toolkit — CLOB API, Gamma API, blockchain tracing, ticket generation, and troubleshooting for the Escalation Engineer role.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pma": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "ts-node --esm",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "scripts:run": "ts-node --esm",
    "demo": "bash scripts/demo-escalation.sh",
    "cli": "node dist/cli/index.js",
    "cli:dev": "ts-node src/cli/index.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "docs:build": "tsx scripts/build-docs.ts",
    "health": "node dist/scripts/health-check.js",
    "postinstall": "husky"
  },
  "keywords": [
    "polymarket",
    "clob",
    "blockchain",
    "escalation",
    "troubleshooting",
    "polygon",
    "usdc",
    "prediction-markets",
    "api-debugging",
    "transaction-tracing"
  ],
  "author": "Julian Martinez",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@polymarket/clob-client": "^2.0.0",
    "viem": "^2.22.0",
    "wagmi": "^2.14.0",
    "@wagmi/core": "^2.14.0",
    "axios": "^1.7.0",
    "ws": "^8.18.0",
    "viem": "^2.22.0",
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/bignumber": "^5.7.0",
    "@ethersproject/rlp": "^5.7.0",
    "@ethersproject/transactions": "^5.7.0",
    "viem": "^2.22.0",
    "@open-rpc/client-js": "^1.8.1",
    "uuid": "^10.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.0",
    "commander": "^12.1.0",
    "inquirer": "^12.3.0",
    "chalk": "^5.4.0",
    "ora": "^8.2.0",
    "table": "^6.9.0",
    "prom-client": "^15.1.3",
    "csv-stringify": "^6.5.2",
    "js-yaml": "^4.1.0",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "@types/uuid": "^10.0.0",
    "@types/table": "^6.3.0",
    "@types/js-yaml": "^4.0.0",
    "@types/json5": "^2.0.0",
    "typescript": "^5.7.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.0",
    "prettier": "^3.4.0",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.19.0",
    "@changesets/cli": "^2.27.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.4.0"
  },
  "lint-staged": {
    "*.ts": ["eslint --fix", "prettier --write"]
  }
}
